# Zkopírujte do .env a nastavte vlastní hodnoty — docker compose je načte automaticky

# Heslo databáze PostgreSQL
POSTGRES_PASSWORD=smartaudit

# Tajemství pro podpis JWT tokenů (min. 32 znaků, v produkci vždy vlastní)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Development zapne dokumentaci API na /scalar
ASPNETCORE_ENVIRONMENT=Development
