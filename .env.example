# Zkopírujte do .env a nastavte vlastní hodnoty — docker compose je načte automaticky

# Heslo databáze PostgreSQL
POSTGRES_PASSWORD=smartaudit

# Tajemství pro podpis JWT tokenů (min. 32 znaků, v produkci vždy vlastní)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Development zapne dokumentaci API na /scalar
ASPNETCORE_ENVIRONMENT=Development

# AI analýza objektu — Azure OpenAI (Azure Portal → prostředek Azure OpenAI → Keys and Endpoint,
# název nasazení modelu z Azure AI Foundry → Deployments). Bez vyplnění aplikace běží, jen AI analýza hlásí „není nastavená“.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# IQRF senzory — adresa tohoto počítače v síti, na kterou se připojí IQRF gateway (MQTT, port 1883).
# Aplikace ji jen ukáže v návodu na obrazovce Senzory; prázdné = návod ukáže adresu, na které běží web.
IQRF_BROKER_PUBLIC_HOST=
