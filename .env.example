# Zkopírujte do .env a nastavte vlastní hodnoty — docker compose je načte automaticky

# Heslo databáze PostgreSQL
POSTGRES_PASSWORD=smartaudit

# Tajemství pro podpis JWT tokenů (min. 32 znaků, v produkci vždy vlastní)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Veřejná adresa aplikace (Raspberry Pi s doménou nebo tunel) — QR kódy na cedulkách a IRI katalogu DCAT-AP-CZ.
# Prázdné = adresa, na které aplikaci otevřete. Po změně: docker compose up --build web api
PUBLIC_URL=

# Development zapne dokumentaci API na /scalar
ASPNETCORE_ENVIRONMENT=Development

# AI analýza objektu — stačí vyplnit jednu ze dvou možností. Bez vyplnění aplikace běží, jen AI analýza hlásí „není nastavená“.

# a) OpenAI — klíč z platform.openai.com → API keys (sk-…), model s podporou temperature (gpt-4o, gpt-4o-mini, gpt-4.1)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Embeddingy pro průvodce (RAG nad znalostmi) — prázdné = průvodce hledá ve znalostech jen podle slov
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# b) Azure OpenAI (Azure Portal → prostředek Azure OpenAI → Keys and Endpoint,
# název nasazení modelu z Azure AI Foundry → Deployments). Má přednost před OpenAI.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Nepovinné: nasazení embeddingového modelu (např. text-embedding-3-small) pro znalosti průvodce
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# IQRF senzory — adresa tohoto počítače v síti, na kterou se připojí IQRF gateway (MQTT přes TLS, port 8883).
# Aplikace ji ukáže v návodu na obrazovce Senzory a broker ji zapíše do svého TLS certifikátu
# (po změně smažte svazek s certifikáty: docker volume rm uhk_hackathon_mqtt_certs).
IQRF_BROKER_PUBLIC_HOST=

# Účet backendu na MQTT brokeru (správa účtů gatewayí přes Dynamic Security) — v produkci vždy vlastní
MQTT_BACKEND_PASSWORD=change-me-mqtt-backend-password

# Tajemství, ze kterého aplikace odvozuje heslo každé gatewaye (HMAC) — v produkci vždy vlastní, min. 32 znaků
MQTT_DEVICE_SECRET=change-me-to-a-long-random-mqtt-device-secret

# Heslo sdíleného párovacího účtu „provisioning“ — nové gatewaye se s ním ohlásí a připojí heslem z nálepky.
# Účet smí jen ohlásit zařízení a převzít zašifrovanou nabídku; prázdné = párování vypnuté
MQTT_PROVISIONING_PASSWORD=change-me-mqtt-provisioning-password

# Kde je dostupný nešifrovaný port 1883: 127.0.0.1 = jen tento počítač (výchozí), 0.0.0.0 = celá síť (nedoporučeno)
MQTT_PLAIN_BIND=127.0.0.1
